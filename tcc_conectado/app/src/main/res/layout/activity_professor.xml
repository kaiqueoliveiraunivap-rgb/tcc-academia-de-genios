<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/BackGround"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        android:text="ÁREA DO PROFESSOR"
        android:textColor="@color/Destaque"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.13" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/txtSaudacaoProfessor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Olá, Professor(a)"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/TextoPrincipal" />

        <Button
            android:id="@+id/btnSairProfessor"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Sair"
            android:textSize="12sp"
            android:textColor="@color/BordaButton"
            android:backgroundTint="@color/ChipFundo"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha uma turma para orientar o estudo ou acompanhar resultados."
        android:textSize="15sp"
        android:textColor="@color/TextoSecundario"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnAbrirDashboard"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Ver desempenho das turmas"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/BackGround"
        android:backgroundTint="@color/btnSelecionado"
        android:layout_marginBottom="25dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="SUAS TURMAS"
        android:textColor="@color/TextoSecundario"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <ProgressBar
        android:id="@+id/progressBarProfessor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtVazioProfessor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhuma turma cadastrada para você ainda."
        android:textSize="15sp"
        android:textColor="@color/BordaButton"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTurmas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
