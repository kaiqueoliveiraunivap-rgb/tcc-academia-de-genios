<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginScroll"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/BackGround">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="24dp" android:paddingTop="28dp" android:paddingEnd="24dp" android:paddingBottom="28dp">
        <TextView android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_login_mark" android:gravity="center" android:contentDescription="Academia de Gênios" android:text="AG" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/TextoNoPrimario" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:text="Bem-vindo à\nAcademia de Gênios" android:textSize="29sp" android:textStyle="bold" android:lineSpacingExtra="2dp" android:textColor="@color/TextoPrincipal" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Entre com a conta fornecida pela secretaria para continuar seus estudos." android:textSize="15sp" android:layout_marginTop="10dp" android:layout_marginBottom="28dp" android:lineSpacingExtra="3dp" android:textColor="@color/TextoSecundario" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTRAR COMO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/TextoSecundario"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnPerfilAluno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Aluno"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="#555555"
                android:backgroundTint="@color/ChipFundo" />

            <Button
                android:id="@+id/btnPerfilProfessor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Professor"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="#555555"
                android:backgroundTint="@color/ChipFundo" />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="E-mail" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:autofillHints="emailAddress" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Senha" app:endIconMode="password_toggle" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSenha" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:autofillHints="password" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/statusLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/TextoSecundario" android:textSize="13sp" android:lineSpacingExtra="2dp" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/progressBarLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
        <Button android:id="@+id/btnEntrar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:text="Entrar como aluno" android:textColor="@color/BackGround" android:textSize="15sp" android:textStyle="bold" android:backgroundTint="@color/btnSelecionado" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="Ainda não tem acesso? Peça sua conta à secretaria." android:textColor="@color/TextoSecundario" android:textSize="13sp" />
        <Button android:id="@+id/btnPainelSecretaria" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="Abrir painel da secretaria ↗" android:textAllCaps="false" android:textSize="14sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>
</ScrollView>
