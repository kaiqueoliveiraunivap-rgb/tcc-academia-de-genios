<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginScroll"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/BackGround">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:padding="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Academia de Gênios" android:textSize="32sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/btnSelecionado" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Escolha seu perfil para entrar" android:textSize="16sp" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="28dp" android:textColor="@color/BordaButton" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIPO DE USUÁRIO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/LabelSecao"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnPerfilAluno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Aluno"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="#555555"
                android:backgroundTint="@color/ChipFundo" />

            <Button
                android:id="@+id/btnPerfilProfessor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Professor"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="#555555"
                android:backgroundTint="@color/ChipFundo" />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="E-mail" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:autofillHints="emailAddress" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Senha" app:endIconMode="password_toggle" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSenha" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:autofillHints="password" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/statusLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/BordaButton" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/progressBarLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
        <Button android:id="@+id/btnEntrar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:text="Entrar como aluno" android:backgroundTint="@color/btnSelecionado" />
        <Button android:id="@+id/btnIrCadastroProfessor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Criar conta de aluno" style="@style/Widget.MaterialComponents.Button.TextButton" />
        <Button android:id="@+id/btnPainelSecretaria" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Acessar painel da secretaria ↗" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>
</ScrollView>
