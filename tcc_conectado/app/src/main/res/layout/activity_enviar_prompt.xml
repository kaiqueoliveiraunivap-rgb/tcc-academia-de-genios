<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BackGround"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personalizar estudo da turma"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/btnSelecionado" />

        <TextView
            android:id="@+id/txtSubtituloPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/BordaButton"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp" />

        <!-- Matéria -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MATÉRIA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/LabelSecao"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/containerMaterias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Instrução do professor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O QUE A TURMA PRECISA REFORÇAR?"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/LabelSecao"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: reforçar frações, pois a turma confunde numerador e denominador"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInstrucaoProfessor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3" android:maxLength="1000"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnGerarPreview"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Pré-visualizar orientação"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/TextoNoPrimario"
            android:backgroundTint="@color/Destaque"
            android:layout_marginBottom="16dp" />

        <!-- Preview -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/CardFundo"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orientação para toda a turma:"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/Destaque"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtPreviewPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/ChipTexto"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/progressBarEnviarPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEnviarPrompt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Aplicar à turma"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/TextoNoPrimario"
            android:backgroundTint="@color/btnSelecionado"
            android:enabled="false"
            android:alpha="0.5"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>
