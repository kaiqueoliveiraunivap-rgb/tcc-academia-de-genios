<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/BackGround">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dashboard_padding"
        android:paddingEnd="@dimen/dashboard_padding"
        android:paddingTop="@dimen/dashboard_padding"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/txtTituloAnalise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Turma"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/btnSelecionado" />

        <TextView
            android:id="@+id/txtSubtituloAnalise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Análise detalhada"
            android:textSize="13sp"
            android:textColor="@color/BordaButton"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarAnalise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtErroAnalise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="15sp"
        android:textColor="@color/BordaButton"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scrollAnalise"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ── Filtros ─────────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TURMA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/LabelSecao"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:id="@+id/containerFiltroTurma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/labelFiltroDisciplina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISCIPLINA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/LabelSecao"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:id="@+id/scrollFiltroDisciplina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:id="@+id/containerFiltroDisciplina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/labelFiltroPeriodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERÍODO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/LabelSecao"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:id="@+id/scrollFiltroPeriodo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:id="@+id/containerFiltroPeriodo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/labelFiltroAvaliacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVALIAÇÃO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/LabelSecao"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:id="@+id/scrollFiltroAvaliacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:id="@+id/containerFiltroAvaliacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- ── Indicadores ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="@dimen/dashboard_card_raio"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/CardFundo">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ALUNOS"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12"
                            android:textColor="@color/LabelSecao" />

                        <TextView
                            android:id="@+id/txtAnaliseAlunos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/btnSelecionado"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardCornerRadius="@dimen/dashboard_card_raio"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/CardFundo">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MÉDIA DA TURMA"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12"
                            android:textColor="@color/LabelSecao" />

                        <TextView
                            android:id="@+id/txtAnaliseMedia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/Destaque"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="@dimen/dashboard_card_raio"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/CardFundo">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MAIOR NOTA"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12"
                            android:textColor="@color/LabelSecao" />

                        <TextView
                            android:id="@+id/txtAnaliseMaior"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/OptCerta"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardCornerRadius="@dimen/dashboard_card_raio"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/CardFundo">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MENOR NOTA"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12"
                            android:textColor="@color/LabelSecao" />

                        <TextView
                            android:id="@+id/txtAnaliseMenor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/OptErrada"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Aprovação (rosca) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dashboard_card_raio"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/CardFundo"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="@dimen/dashboard_espaco_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Taxa de aprovação"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/btnSelecionado" />

                    <TextView
                        android:id="@+id/txtLegendaAprovacaoAnalise"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/TextoSecundario"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/chartAprovacaoAnalise"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dashboard_grafico_medio" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Distribuição das notas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dashboard_card_raio"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/CardFundo"
                android:layout_marginBottom="@dimen/dashboard_espaco_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distribuição das notas"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/btnSelecionado" />

                    <TextView
                        android:id="@+id/txtLegendaDistribuicao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quantidade de notas em cada faixa."
                        android:textSize="12sp"
                        android:textColor="@color/TextoSecundario"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chartDistribuicao"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dashboard_grafico_medio" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Desempenho por avaliação -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dashboard_card_raio"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/CardFundo"
                android:layout_marginBottom="@dimen/dashboard_espaco_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Desempenho por avaliação"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/btnSelecionado" />

                    <TextView
                        android:id="@+id/txtLegendaAvaliacoes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Toque em uma barra para ver os detalhes da avaliação."
                        android:textSize="12sp"
                        android:textColor="@color/TextoSecundario"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chartAvaliacoes"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dashboard_grafico_medio" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Evolução -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dashboard_card_raio"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/CardFundo"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evolução ao longo do tempo"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/btnSelecionado" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Média da turma mês a mês (escala 0 a 10)."
                        android:textSize="12sp"
                        android:textColor="@color/TextoSecundario"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartEvolucaoAnalise"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dashboard_grafico_medio" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALUNOS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/LabelSecao"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAlunosAnalise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/txtVazioAlunos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhuma nota lançada para os filtros escolhidos."
                android:textSize="14sp"
                android:textColor="@color/TextoSecundario"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
