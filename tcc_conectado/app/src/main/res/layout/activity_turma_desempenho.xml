<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/BackGround">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/txtTituloTurma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Turma"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/btnSelecionado" />

        <TextView
            android:id="@+id/txtSubtituloTurma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desempenho dos alunos (pontos acumulados)"
            android:textSize="13sp"
            android:textColor="@color/BordaButton"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarDesempenho"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtVazioDesempenho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Essa turma ainda não tem alunos matriculados."
        android:textSize="15sp"
        android:textColor="@color/BordaButton"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scrollDesempenho"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="18dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartDesempenho"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:padding="12dp" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALUNOS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#999999"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAlunosDesempenho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
