<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizMaterias"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/BackGround"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/btnVoltarMaterias"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:contentDescription="Voltar ao menu"
                android:text="‹  Voltar"
                android:textColor="@color/Destaque"
                android:textSize="16sp" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="O que vamos estudar?"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="@color/TextoPrincipal"
                android:layout_marginTop="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escolha uma matéria para ver os conteúdos da sua série."
                android:textSize="15sp"
                android:textColor="@color/TextoSecundario"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"/>

            <!-- Label matéria -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MATÉRIA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/BordaButton"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"/>

            <!-- Grid de matérias -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMaterias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp"/>

            <!-- Loading -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvCarregando"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preparando seu estudo…"
                    android:textSize="14sp"
                    android:textColor="@color/Destaque"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- Botão iniciar -->
            <Button
                android:id="@+id/btnIniciar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:padding="12dp"
                android:text="Ver conteúdos"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/TextoNoPrimario"
                android:backgroundTint="@color/Destaque"
                android:enabled="false"
                android:alpha="0.5"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
