<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AcademiaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="${cleartextTraffic}"
        android:theme="@style/Theme.Tcc">

        <!-- O app passa a abrir pelo login. Antes o LAUNCHER estava na
             MainActivity, o que deixava qualquer pessoa entrar direto no quiz
             (e em qualquer outro app iniciar essa tela, por estar exported). -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CadastroProfessorActivity"
            android:exported="false"/>

        <activity android:name=".CapitulosActivity" android:exported="false"/>
        <activity android:name=".ConteudosActivity" android:exported="false"/>
        <activity android:name=".AtividadesActivity" android:exported="false"/>
        <activity android:name=".HistoricoActivity" android:exported="false"/>
        <activity android:name=".RevisaoQuizActivity" android:exported="false"/>
        <activity android:name=".FrentesActivity" android:exported="false"/>
        <activity android:name=".MenuActivity" android:exported="false"/>
        <activity android:name=".MinhaContaActivity" android:exported="false"/>
        <activity android:name=".SelecionarRelatorioActivity" android:exported="false"/>
        <activity android:name=".DesempenhoTopicosActivity" android:exported="false"/>

        <activity
            android:name=".MainActivity"
            android:exported="false"/>

        <activity
            android:name=".SelecionarMateriaActivity"
            android:exported="false"/>

        <activity
            android:name=".ResultadoActivity"
            android:exported="false"/>

        <activity
            android:name=".RankingActivity"
            android:exported="false"/>

        <activity
            android:name=".GraficosActivity"
            android:exported="false"/>

        <activity
            android:name=".ProfessorActivity"
            android:exported="false"/>

        <activity
            android:name=".TurmaDesempenhoActivity"
            android:exported="false"/>

        <activity
            android:name=".EnviarPromptActivity"
            android:exported="false"/>

        <!-- Dashboard de Desempenho das Turmas (exclusivo do professor) -->
        <activity
            android:name=".DashboardTurmasActivity"
            android:exported="false"/>

        <activity
            android:name=".TurmaAnaliseActivity"
            android:exported="false"/>

    </application>

</manifest>
